	"exempt": [
		{
			"name": "--ec-backdrop-opacity",
			"reason": "The alpha of the settings drawer scrim, not a colour: it dims the content behind the drawer and carries no information.",
			"fill": "Painted as the alpha of the settings-drawer scrim rgba(0, 0, 0, var(--ec-backdrop-opacity)) (settings_drawer.css:37), a non-text dimming layer behind the drawer that carries no information."
		},
		{
			"name": "--ec-border-status-bar",
			"reason": "The status bar's top border (transparent in the light theme, the border colour in the dark theme) separates two regions that are each labelled; it carries no information."
		},
		{
			"name": "--ec-color-border",
			"reason": "Hairline dividers (the 1 px borders of rows, cards and controls) carry no information that a label does not also carry: every bordered control is labelled, so SC 1.4.11 does not apply to the line.",
			"fill": "Painted as a fill by the 1 px language-dropdown separator (language_dropdown.css:105), a divider between labelled items that carries no information."
		},
		{
			"name": "--ec-color-info",
			"reason": "Declared in tokens.css and used nowhere in src/renderer, so no pixel is painted with it; token_map.json retires it for v5.1."
		},
		{
			"name": "--ec-shadow-drawer",
			"reason": "A shadow colour, not a foreground or a backdrop: the settings drawer's drop shadow adds depth only and carries no information."
		}
