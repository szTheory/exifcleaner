# Test-only anti-pattern control for LIF-01. It exits on SIGALRM as soon as the parent changes,
# with no ReadStayOpen stack check, so it can interrupt a write. It is never packaged (no
# extraResources entry copies tests/) and it must keep its trailing `1;`.
{
    my $ppid = getppid();
    $SIG{ALRM} = sub {
        exit 0 if getppid() != $ppid;
        alarm 1;
    };
    alarm 1;
}
1;
