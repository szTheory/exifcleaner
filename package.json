{
	"name": "exifcleaner",
	"productName": "ExifCleaner",
	"version": "4.1.0",
	"description": "Clean exif metadata from images, videos, and PDF documents",
	"license": "MIT",
	"repository": "github:szTheory/exifcleaner",
	"type": "module",
	"main": "./out/main/index.js",
	"author": {
		"name": "szTheory",
		"email": "szTheory@users.noreply.github.com",
		"url": "https://exifcleaner.com"
	},
	"scripts": {
		"update-exiftool": "./update_exiftool.pl",
		"postinstall": "electron-builder install-app-deps",
		"format": "yarn prettier --write '{src,tests,scripts}/**/*.{ts,tsx,mjs,js}'",
		"lint": "prettier --check '{src,tests,scripts}/**/*.{ts,tsx,mjs,js}'",
		"start": "ELECTRON_RUN_AS_NODE= electron-vite preview",
		"packmactest": "yarn run compile && electron-builder --dir -c.compression=store",
		"packwin": "yarn run compile && electron-builder --windows --publish never",
		"packlinux": "yarn run compile && electron-builder --linux --publish never",
		"packmac": "yarn run compile && electron-builder --macos --publish never",
		"packmacdir": "yarn run compile && electron-builder --macos --dir -c.compression=store",
		"packwindir": "yarn run compile && electron-builder --windows --dir -c.compression=store",
		"packlinuxdir": "yarn run compile && electron-builder --linux --dir -c.compression=store",
		"build": "yarn run compile && electron-builder --macos --linux --windows --publish never",
		"release": "echo 'Use GitHub Actions release workflow (workflow_dispatch) instead' && exit 1",
		"dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
		"dev:debug": "ELECTRON_RUN_AS_NODE= electron-vite dev --remote-debugging-port=9222",
		"compile": "electron-vite build",
		"typecheck": "tsc --noEmit",
		"preview": "ELECTRON_RUN_AS_NODE= electron-vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=dev",
		"test:smoke": "playwright test --project=smoke",
		"test:all": "vitest run && playwright test --project=dev",
		"i18n:write": "node scripts/i18n_resources.mjs --write",
		"i18n:check": "node scripts/i18n_resources.mjs --check",
		"docs:verify": "node scripts/verify_docs.mjs",
		"verify:gatekeeper": "node scripts/gatekeeper_check.mjs",
		"verify:direffect": "node scripts/dir_effect_gate.mjs",
		"verify:known-gaps": "node scripts/known_gap_gate.mjs",
		"verify:release-notes": "node scripts/release_notes_gate.mjs",
		"release:evidence": "node scripts/release_evidence.mjs --write",
		"release:prepare-assets": "node scripts/release_asset_gate.mjs --write-checksums",
		"release:finalize-notes": "node scripts/finalize_release_notes.mjs",
		"release:phase25-issues": "node scripts/phase25_issue_actions.mjs",
		"verify:phase25-public": "node scripts/phase25_public_state_gate.mjs",
		"verify:release-evidence": "node scripts/release_evidence.mjs --validate-set",
		"verify:release-assets": "node scripts/release_asset_gate.mjs",
		"verify:release-tags": "node scripts/release_tag_gate.mjs",
		"release-tags:capture-evidence": "node scripts/release_tag_gate.mjs --capture-evidence",
		"verify:accountability:policy": "node scripts/oracle_accountability_gate.mjs",
		"verify:accountability:mutation": "node scripts/orientation_mutation_gate.mjs",
		"verify:accountability": "yarn verify:accountability:policy && yarn verify:accountability:mutation",
		"accountability:write-claims": "node scripts/oracle_accountability_gate.mjs --write-claims",
		"known-gaps:write": "node scripts/known_gap_gate.mjs --write-release-notes",
		"known-gaps:check": "node scripts/known_gap_gate.mjs --check-release-notes",
		"verify:release": "yarn verify:release-notes && yarn verify:release-tags && yarn verify:known-gaps --release && yarn known-gaps:check && yarn i18n:check && yarn docs:verify && yarn lint && yarn typecheck && yarn test && yarn verify:direffect && yarn check:deps",
		"screenshots": "tsx scripts/generate-screenshots.ts",
		"check:deps": "madge --circular --extensions ts,tsx src/"
	},
	"dependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@playwright/test": "1.62.0",
		"@types/node": "^22",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^4.7.0",
		"electron": "43.2.0",
		"electron-builder": "26.15.3",
		"electron-vite": "^5.0.0",
		"madge": "^8.0.0",
		"playwright": "1.62.0",
		"prettier": "^3.0",
		"tsx": "^4.23.1",
		"typescript": "~5.7.0",
		"vite": "7.3.6",
		"vitest": "3.2.7"
	},
	"build": {
		"afterPack": "./scripts/afterPack.cjs",
		"appId": "com.exifcleaner",
		"mac": {
			"category": "public.app-category.graphics-and-images",
			"minimumSystemVersion": "12.0",
			"darkModeSupport": true,
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64",
						"x64"
					]
				}
			],
			"identity": null,
			"hardenedRuntime": false,
			"notarize": false,
			"extraResources": [
				{
					"from": ".resources/nix/bin",
					"to": "nix/bin",
					"filter": [
						"**/*"
					]
				}
			]
		},
		"dmg": {
			"iconSize": 160
		},
		"linux": {
			"target": [
				"appImage",
				"deb",
				"rpm"
			],
			"icon": "build/icon.icns",
			"category": "Graphics",
			"extraResources": [
				{
					"from": ".resources/nix/bin",
					"to": "nix/bin",
					"filter": [
						"**/*"
					]
				}
			]
		},
		"nsis": {
			"artifactName": "${productName}.Setup.${version}.${ext}",
			"oneClick": true,
			"perMachine": false,
			"runAfterFinish": false
		},
		"portable": {
			"artifactName": "${productName}.${version}.${ext}"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"ia32"
					]
				},
				{
					"target": "portable"
				}
			],
			"extraResources": [
				{
					"from": ".resources/win/bin",
					"to": "win/bin",
					"filter": [
						"**/*"
					]
				}
			]
		},
		"extraResources": [
			{
				"from": ".resources/",
				"to": "",
				"filter": [
					"strings.json",
					"*.png"
				]
			}
		]
	},
	"resolutions": {
		"vite": "7.3.6"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
