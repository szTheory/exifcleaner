					"status": "waived",
					"waiver": {
						"basis": "unreachable",
						"ref": "src/renderer/components/file-list/ErrorExpansion.tsx#error",
						"reason": "FileRow renders the pattern only when the error text is not null, and every failure path supplies one, so an empty pattern never appears."
					}
				},
				"one": {
					"status": "waived",
					"waiver": {
						"basis": "unreachable",
						"ref": "src/renderer/components/file-list/ErrorExpansion.tsx#error",
						"reason": "The pattern shows one error string for one row and has no count, so there is no singular or plural wording to test."
					}
				},
				"many": {
					"status": "waived",
					"waiver": {
						"basis": "unreachable",
						"ref": "src/renderer/components/file-list/ErrorExpansion.tsx#onCopy",
						"reason": "Only one row is expanded at a time (expandedRowId), so the pattern never renders twice; a mixed batch is the file table's area story."
					}
				},
				"boundary": {
					"status": "waived",
					"waiver": {
						"basis": "duplicate",
						"ref": "error-expansion.long-detail",
						"reason": "ErrorExpansion codes no length cap or size limit, and the longest string it ever wraps is the long-detail scenario, so a boundary row would repeat it."
					}
				},
				"loading": {
					"status": "waived",
					"waiver": {
						"basis": "unreachable",
						"ref": "src/renderer/components/file-list/ErrorExpansion.tsx#handleCopy",
						"reason": "A row in flight is Pending, Reading or Processing and cannot expand; the pattern appears only after a verdict, and its copy write settles at once."
					}
