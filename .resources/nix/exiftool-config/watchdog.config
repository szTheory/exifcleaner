# ExifCleaner parent-death watchdog (LIF-01). This file is owned by ExifCleaner,
# not by update_exiftool.pl, and is loaded through ExifTool's -config option.
#
# It exits the ExifTool process only when the expected parent is gone AND the
# process is idle inside its -stay_open argfile read loop (ReadStayOpen is
# on the call stack). An in-flight write is therefore never interrupted.
#
# The expected parent is EXIFCLEANER_PARENT_PID when it holds a positive integer;
# otherwise it falls back to the getppid() value captured at load.
{
    use POSIX ();
    my $env = $ENV{EXIFCLEANER_PARENT_PID};
    my $ppid = (defined $env && $env =~ /^[1-9][0-9]*$/) ? $env + 0 : getppid();
    my $tick = 1;
    my $handler = sub {
        if (getppid() != $ppid) {
            my $i = 0;
            while (my @c = caller($i++)) {
                POSIX::_exit(0) if $c[3] eq 'main::ReadStayOpen';
            }
        }
        alarm $tick;
    };
    POSIX::sigaction(POSIX::SIGALRM(),
        POSIX::SigAction->new($handler, POSIX::SigSet->new(), POSIX::SA_RESTART()));
    alarm $tick;
}
1;
